{
    "name": "@ng-org/shell",
    "private": true,
    "version": "0.1.2-alpha.1",
    "description": "NextGraph shell in Svelte 5, running all micro-apps.",
    "type": "module",
    "scripts": {
        "dev": "node build-apps.ts && vite",
        "build": "node build-apps.ts build && vite build",
        "buildalone": "vite build",
        "previewalone": "vite preview",
        "preview": "pnpm build && vite preview",
        "tauri": "tauri",
        "format": "prettier --write .",
        "check": "svelte-check --tsconfig ./tsconfig.json",
        "webdev": "node build-apps.ts && cross-env NG_ENV_WEB=1 TAURI_DEBUG=1 NG_ENV_NO_REDIRECT=1 vite",
        "webbuild": "node build-apps.ts build && cross-env NG_ENV_WEB=1 vite build && node prepare-web-file.cjs",
        "webpreview": "pnpm webbuild && cross-env NG_ENV_WEB=1 vite preview",
        "libwasm": "cd ../.. && cargo install cargo-run-script && cargo run-script libwasm",
        "buildfrontdev": "pnpm -C ../../infra/ngnet/bootstrap builddev && pnpm -C ../../infra/ngnet/auth builddev && pnpm -C ../../infra/ngnet/redir builddev"
    },
    "dependencies": {
        "@ark-ui/svelte": "^5.21.2",
        "@ng-org/alien-deepsignals": "workspace:*",
        "@ng-org/api": "workspace:*",
        "@ng-org/api-web": "workspace:*",
        "@ng-org/frontend": "workspace:*",
        "@svelte-router/core": "^1.0.7",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-barcode-scanner": "2",
        "@tauri-apps/plugin-opener": "^2",
        "@wjfe/single-spa-svelte": "^1.0.1",
        "async-proxy": "^0.4.1",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router": "^7.16.0",
        "single-spa": "^6.0.3",
        "single-spa-react": "^6.0.2",
        "vue": "^3.5.34"
    },
    "devDependencies": {
        "@hazycora/vite-plugin-svelte-svg": "^2.4.3",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.2.4",
        "@tauri-apps/cli": "^2.11.3",
        "@tsconfig/svelte": "^5.0.8",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "cjs-module-lexer": "^2.2.0",
        "cross-env": "^10.1.0",
        "daisyui": "^5.5.19",
        "fast-deep-equal": "^3.1.3",
        "node-gzip": "^1.1.2",
        "prettier": "^3.6.2",
        "prettier-plugin-svelte": "^3.4.0",
        "svelte": "^5.55.9",
        "svelte-check": "^4.3.3",
        "tailwindcss": "^4.2.4",
        "typescript": "^6.0.3",
        "vite": "^8",
        "vite-import-maps": "^0.2.6",
        "vite-plugin-single-spa": "^2.1.1",
        "vite-plugin-top-level-await": "^1.6.0",
        "vite-plugin-wasm": "^3.6.0"
    }
}
